@model Website.Models.Borrow

@{
    ViewData["Title"] = "Cập nhật phiếu mượn";
    Layout = "~/Views/Shared/Master.cshtml";
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/CSS/Admin/Views/Style.css" asp-append-version="true" />
}

<div class="container-fluid">
    <h1 class="mt-4">Cập nhật phiếu mượn</h1>

    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-action="Index">Danh sách phiếu mượn</a></li>
        <li class="breadcrumb-item active">Cập nhật</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-edit me-1"></i>
            Cập nhật thông tin phiếu: <strong>#@Model.idBorrow</strong>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-8">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <input type="hidden" asp-for="idBorrow" />

                        <div class="form-group mb-3">
                            <label asp-for="idCard" class="control-label fw-bold">Mã thẻ độc giả</label>
                            <input asp-for="idCard" class="form-control" readonly style="background-color: #e9ecef;" />
                            <span asp-validation-for="idCard" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="idLibrarian" class="control-label fw-bold">Mã thủ thư</label>
                            <input asp-for="idLibrarian" class="form-control" placeholder="Nhập mã thủ thư..." />
                            <span asp-validation-for="idLibrarian" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="dateBorrow" class="control-label fw-bold">Ngày mượn</label>
                            <input asp-for="dateBorrow" type="date" class="form-control" />
                            <span asp-validation-for="dateBorrow" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="statusBorrow" class="control-label fw-bold">Trạng thái</label>
                            <select asp-for="statusBorrow" class="form-select">
                                <option value="Dang muon">Đang mượn</option>
                                <option value="Da tra">Đã trả</option>
                                <option value="Qua han">Quá hạn</option>
                            </select>
                            <span asp-validation-for="statusBorrow" class="text-danger"></span>
                        </div>

                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-warning">
                                <i class="fa fa-save"></i> Lưu thay đổi
                            </button>
                            <a asp-action="Index" class="btn btn-secondary ms-2">
                                <i class="fa fa-arrow-left"></i> Quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}