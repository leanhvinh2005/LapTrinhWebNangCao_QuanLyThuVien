@model IEnumerable<Website.Models.Borrow>

@{
    ViewData["Title"] = "Quản lý Mượn Trả";
    Layout = "~/Views/Shared/Master.cshtml";
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/CSS/Admin/Views/Style.css" asp-append-version="true" />
}

<div class="container-fluid">
    <h1 class="mt-4">Danh sách phiếu mượn</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row mb-3">
        <div class="col-md-6">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fa fa-plus me-1"></i> Tạo phiếu mượn mới
            </a>
        </div>
        <div class="col-md-6">
            <form asp-action="Index" method="get" class="d-flex justify-content-end">
                <div class="input-group" style="max-width: 400px;">
                    <input type="text" name="search" class="form-control" placeholder="Tìm theo mã thẻ..." value="@ViewData["CurrentSearch"]" />
                    <button type="submit" class="btn btn-primary">Tìm</button>
                    <a asp-action="Index" class="btn btn-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th style="width: 10%;">ID Mượn</th>
                <th style="width: 15%;">Mã thẻ độc giả</th>
                <th style="width: 15%;">Mã thủ thư</th>
                <th style="width: 15%;">Ngày mượn</th>
                <th>Trạng thái</th>
                <th style="width: 20%;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.idBorrow</td>
                        <td>@item.idCard</td>
                        <td>
                            @if (item.idLibrarian != null)
                            {
                                @item.idLibrarian
                            }
                            else
                            {
                                <span class="text-muted fst-italic">Chưa cập nhật</span>
                            }
                        </td>
                        <td>@item.dateBorrow.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (item.statusBorrow == "Da tra" || item.statusBorrow == "Đã trả")
                            {
                                <span class="badge bg-success">Đã trả</span>
                            }
                            else if (item.statusBorrow == "Qua han" || item.statusBorrow == "Quá hạn")
                            {
                                <span class="badge bg-danger">Quá hạn</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">@item.statusBorrow</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.idBorrow" class="btn btn-sm btn-warning" title="Sửa trạng thái">
                                <i class="fa fa-edit"></i> Sửa
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.idBorrow" class="btn btn-sm btn-danger" title="Xóa phiếu">
                                <i class="fa fa-trash"></i> Xóa
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">
                        Không tìm thấy phiếu mượn nào.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>