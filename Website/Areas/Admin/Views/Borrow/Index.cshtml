@model IEnumerable<Website.Models.Borrow>

@{
    ViewData["Title"] = "Quản lý Mượn Trả";
    Layout = "~/Views/Shared/Master.cshtml";
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/CSS\Admin\Views\Style.css" asp-append-version="true" />
}

<div class="container-fluid">
    <h1 class="mt-4">Danh sách phiếu mượn</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fa fa-plus"></i> Tạo phiếu mượn mới
        </a>
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID Mượn</th>
                <th>Mã thẻ độc giả</th>
                <th>Mã thủ thư</th>
                <th>Ngày mượn</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.idBorrow</td>
                    <td>@item.idCard</td>
                    <td>
                        @if (item.idLibrarian != null)
                        {
                            @item.idLibrarian
                        }
                        else
                        {
                            <span class="text-muted">Chưa cập nhật</span>
                        }
                    </td>
                    <td>@item.dateBorrow.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (item.statusBorrow == "Da tra")
                        {
                            <span class="badge bg-success">Đã trả</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">@item.statusBorrow</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.idBorrow" class="btn btn-sm btn-warning">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.idBorrow" class="btn btn-sm btn-danger">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>