@model Website.Models.Borrow

@{
    ViewData["Title"] = "Xóa phiếu mượn";
    Layout = "~/Views/Shared/Master.cshtml";
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/CSS/Admin/Views/Style.css" asp-append-version="true" />
}

<div class="container-fluid">
    <h1 class="mt-4 text-danger">Xác nhận xóa</h1>

    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-action="Index">Danh sách phiếu mượn</a></li>
        <li class="breadcrumb-item active">Xóa</li>
    </ol>

    <div class="alert alert-warning" role="alert">
        <i class="fa fa-exclamation-triangle me-2"></i>
        <strong>Cảnh báo:</strong> Hành động này không thể hoàn tác. Xóa phiếu mượn có thể ảnh hưởng đến dữ liệu sách đang được mượn trong phiếu này (ví dụ: làm mất lịch sử mượn).
    </div>

    <div class="card mb-4 border-danger">
        <div class="card-header bg-danger text-white">
            <i class="fas fa-trash-alt me-1"></i>
            Thông tin phiếu mượn cần xóa
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">ID Phiếu mượn:</dt>
                <dd class="col-sm-9 fw-bold">@Model.idBorrow</dd>

                <dt class="col-sm-3">Mã thẻ độc giả:</dt>
                <dd class="col-sm-9 text-primary">@Model.idCard</dd>

                <dt class="col-sm-3">Ngày mượn:</dt>
                <dd class="col-sm-9">@Model.dateBorrow.ToString("dd/MM/yyyy")</dd>

                <dt class="col-sm-3">Trạng thái:</dt>
                <dd class="col-sm-9">
                    @if (Model.statusBorrow == "Da tra" || Model.statusBorrow == "Đã trả")
                    {
                        <span class="badge bg-success">Đã trả</span>
                    }
                    else if (Model.statusBorrow == "Qua han" || Model.statusBorrow == "Quá hạn")
                    {
                        <span class="badge bg-danger">Quá hạn</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">@Model.statusBorrow</span>
                    }
                </dd>
            </dl>

            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="idBorrow" />

                <button type="submit" class="btn btn-danger">
                    <i class="fa fa-trash-alt me-1"></i> Xóa vĩnh viễn
                </button>

                <a asp-action="Index" class="btn btn-secondary ms-2">
                    <i class="fa fa-times me-1"></i> Hủy bỏ
                </a>
            </form>
        </div>
    </div>
</div>