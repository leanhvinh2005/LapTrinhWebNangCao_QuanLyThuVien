@model Website.Models.Tag

@{
    ViewData["Title"] = "Chỉnh sửa Tag";
    Layout = "~/Views/Shared/Master.cshtml";
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/CSS/Admin/Views/Style.css" asp-append-version="true" />
}

<div class="container-fluid">
    <h1 class="mt-4">Chỉnh sửa Tag</h1>

    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-action="Index">Danh sách Tag</a></li>
        <li class="breadcrumb-item active">Chỉnh sửa</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-edit me-1"></i>
            Cập nhật thông tin: <strong>@Model.nameTag</strong>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-8">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <input type="hidden" asp-for="idTag" />

                        <div class="form-group mb-3">
                            <label class="control-label fw-bold">ID Tag</label>
                            <input class="form-control" value="@Model.idTag" readonly style="background-color: #e9ecef;" />
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="nameTag" class="control-label fw-bold">Tên Tag</label>
                            <input asp-for="nameTag" class="form-control" />
                            <span asp-validation-for="nameTag" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="typeTag" class="control-label fw-bold">Loại</label>
                            <input asp-for="typeTag" class="form-control" />
                            <span asp-validation-for="typeTag" class="text-danger"></span>
                        </div>

                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-warning">
                                <i class="fa fa-save"></i> Lưu thay đổi
                            </button>
                            <a asp-action="Index" class="btn btn-secondary ms-2">
                                <i class="fa fa-arrow-left"></i> Quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}