@model Website.Models.Tag

@{
    ViewData["Title"] = "Chỉnh sửa Tag";
    Layout = "~/Views/Shared/Master.cshtml";
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/CSS/Admin/Views/Style.css" asp-append-version="true" />
}

<div class="container-fluid">
    <h1 class="mt-4">Chỉnh sửa Tag</h1>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input type="hidden" asp-for="idTag" />

                <div class="form-group mb-3">
                    <label asp-for="nameTag" class="control-label fw-bold">Tên Tag</label>
                    <input asp-for="nameTag" class="form-control" />
                    <span asp-validation-for="nameTag" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="typeTag" class="control-label fw-bold">Loại</label>
                    <input asp-for="typeTag" class="form-control" />
                    <span asp-validation-for="typeTag" class="text-danger"></span>
                </div>

                <div class="form-group mt-3">
                    <input type="submit" value="Lưu thay đổi" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}