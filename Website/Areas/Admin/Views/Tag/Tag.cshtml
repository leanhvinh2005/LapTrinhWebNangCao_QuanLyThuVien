@model IEnumerable<Website.Models.Tag>

@{
    ViewData["Title"] = "Quản lý Thẻ (Tag)";
    Layout = "~/Views/Shared/Master.cshtml";
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/CSS\Admin\Views\Style.css" asp-append-version="true" />
}

<h2>@ViewData["Title"]</h2>

<p>
    <a asp-action="Create" class="btn-create">Tạo Tag mới</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Tên Tag</th>
            <th>Loại (Type)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.idTag</td>
                <td>@item.nameTag</td>
                <td>@item.typeTag</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.idTag"><i class="fa-solid fa-pen-to-square"></i></a> |
                    <a asp-action="Delete" asp-route-id="@item.idTag"><i class="fa-solid fa-trash"></i></a>
                </td>
            </tr>
        }
    </tbody>
</table>