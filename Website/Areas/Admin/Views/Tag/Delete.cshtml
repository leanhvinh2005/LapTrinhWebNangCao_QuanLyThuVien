@model Website.Models.Tag

@{
    ViewData["Title"] = "Xóa Tag";
    Layout = "~/Views/Shared/Master.cshtml";
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/CSS/Admin/Views/Style.css" asp-append-version="true" />
}

<div class="container-fluid">
    <h1 class="mt-4 text-danger">Xác nhận xóa</h1>

    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-action="Index">Danh sách Tag</a></li>
        <li class="breadcrumb-item active">Xóa</li>
    </ol>

    <div class="alert alert-warning" role="alert">
        <i class="fa fa-exclamation-triangle me-2"></i>
        <strong>Cảnh báo:</strong> Hành động này không thể hoàn tác. Nếu Tag này đang được gắn cho sách, việc xóa có thể làm mất thông tin phân loại của sách đó.
    </div>

    <div class="card mb-4 border-danger">
        <div class="card-header bg-danger text-white">
            <i class="fas fa-trash-alt me-1"></i>
            Thông tin Tag cần xóa
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">ID Tag:</dt>
                <dd class="col-sm-9 fw-bold">@Model.idTag</dd>

                <dt class="col-sm-3">Tên Tag:</dt>
                <dd class="col-sm-9 text-primary fw-bold">@Model.nameTag</dd>

                <dt class="col-sm-3">Loại:</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-info text-dark">@Model.typeTag</span>
                </dd>
            </dl>

            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="idTag" />
                <button type="submit" class="btn btn-danger">
                    <i class="fa fa-trash-alt me-1"></i> Xác nhận xóa vĩnh viễn
                </button>
                <a asp-action="Index" class="btn btn-secondary ms-2">
                    <i class="fa fa-times me-1"></i> Hủy bỏ
                </a>
            </form>
        </div>
    </div>
</div>