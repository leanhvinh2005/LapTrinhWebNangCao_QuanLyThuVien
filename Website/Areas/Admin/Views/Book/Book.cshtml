@model IEnumerable<Website.Models.Book>

@{
    ViewData["Title"] = "Quản lý Sách";
    Layout = "~/Views/Shared/Master.cshtml";
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/CSS/Admin/Views/Style.css" asp-append-version="true" />
}

<div class="container-fluid">
    <h1 class="mt-4">Danh sách Sách</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row mb-3">
        <div class="col-md-6">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fa fa-plus"></i> Tạo sách mới
            </a>
        </div>
        <div class="col-md-6">
            <form asp-action="Index" method="get" class="d-flex justify-content-end">
                <div class="input-group" style="max-width: 400px;">
                    <input type="text" name="search" class="form-control" placeholder="Tìm tên sách..." value="@ViewData["CurrentSearch"]" />
                    <button type="submit" class="btn btn-primary">Tìm</button>
                    <a asp-action="Index" class="btn btn-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th style="width: 10%;">ID Sách</th>
                <th style="width: 25%;">Tên sách</th>
                <th style="width: 15%;">Tác giả</th>
                <th style="width: 15%;">Nhà xuất bản</th>
                <th>Trạng thái</th>
                <th>Chương</th>
                <th style="width: 15%;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.idBook</td>
                        <td>@item.nameBook</td>
                        <td>@item.authorBook</td>
                        <td>@item.publisherBook</td>
                        <td>
                            @if (item.statusBook == "Available")
                            {
                                <span class="badge bg-success">Có sẵn</span>
                            }
                            else if (item.statusBook == "Borrowed")
                            {
                                <span class="badge bg-warning text-dark">Đang mượn</span>
                            }
                            else if (item.statusBook == "Lost")
                            {
                                <span class="badge bg-danger">Đã mất</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@item.statusBook</span>
                            }
                        </td>

                        <td>
                            <a asp-area="Admin" asp-controller="Chapter" asp-action="Index" asp-route-bookId="@item.idBook" class="btn btn-sm btn-info text-white">
                                <i class="fa fa-list"></i> Xem DS Chương
                            </a>
                        </td>

                        <td>
                            <a asp-action="Edit" asp-route-id="@item.idBook" class="btn btn-sm btn-warning">
                                <i class="fa fa-edit"></i> Sửa
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.idBook" class="btn btn-sm btn-danger">
                                <i class="fa fa-trash"></i> Xóa
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">Không tìm thấy sách nào.</td>
                </tr>
            }
        </tbody>
    </table>
</div>