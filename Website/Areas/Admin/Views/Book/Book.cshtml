@model IEnumerable<Website.Models.Book>

@{
    ViewData["Title"] = "Quản lý Sách";
    Layout = "~/Views/Shared/Master.cshtml";
}

<h2>@ViewData["Title"]</h2>

<p>
    <a asp-action="Create">Tạo sách mới</a>
</p>

<form asp-action="Index" method="get">
    <div class="form-actions no-color">
        <p>
            Tìm kiếm: <input type="text" name="search" value="@ViewData["CurrentSearch"]" />
            <input type="submit" value="Tìm" class="btn btn-primary" /> |
            <a asp-action="Index">Xem tất cả</a>
        </p>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>ID Sách</th>
            <th>Tên sách</th>
            <th>Tác giả</th>
            <th>Nhà xuất bản</th>
            <th>Trạng thái</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.idBook</td>
                <td>@item.nameBook</td>
                <td>@item.authorBook</td>
                <td>@item.publisherBook</td>
                <td>@item.statusBook</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.idBook">Sửa</a> |
                    <a asp-action="Delete" asp-route-id="@item.idBook">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>