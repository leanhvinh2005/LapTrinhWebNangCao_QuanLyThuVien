@model Website.Models.Book

@{
    ViewData["Title"] = "Chỉnh sửa sách";
    Layout = "~/Views/Shared/Master.cshtml";
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/CSS\Admin\Views\Style.css" asp-append-version="true" />
}

<h2>@ViewData["Title"]</h2>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="idBook" class="control-label">ID Sách</label>
                <input asp-for="idBook" class="form-control" readonly />
            </div>

            <div class="form-group">
                <label asp-for="nameBook" class="control-label">Tên sách</label>
                <input asp-for="nameBook" class="form-control" />
                <span asp-validation-for="nameBook" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="descriptionBook" class="control-label">Mô tả</label>
                <textarea asp-for="descriptionBook" class="form-control" rows="3"></textarea>
            </div>

            <div class="form-group">
                <label asp-for="authorBook" class="control-label">Tác giả</label>
                <input asp-for="authorBook" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="publisherBook" class="control-label">Nhà xuất bản</label>
                <input asp-for="publisherBook" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="dateBook" class="control-label">Ngày xuất bản</label>
                <input asp-for="dateBook" class="form-control" type="date" />
            </div>

            <div class="form-group">
                <label asp-for="formatBook" class="control-label">Định dạng</label>
                <input asp-for="formatBook" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="statusBook" class="control-label">Trạng thái</label>
                <input asp-for="statusBook" class="form-control" />
                <span asp-validation-for="statusBook" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="noteBook" class="control-label">Ghi chú</label>
                <textarea asp-for="noteBook" class="form-control" rows="2"></textarea>
            </div>

            <div class="form-group">
                <label asp-for="imageBook" class="control-label">Đường dẫn ảnh (Image URL)</label>
                <input asp-for="imageBook" class="form-control" />
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Lưu thay đổi" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-primary">Quay lại danh sách</a>
            </div>
        </form>
    </div>
</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
