@model Website.Models.Book

@{
    ViewData["Title"] = "Chỉnh sửa sách";
    Layout = "~/Views/Shared/Master.cshtml";
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/CSS/Admin/Views/Style.css" asp-append-version="true" />
}

<div class="container-fluid">
    <h1 class="mt-4">Chỉnh sửa sách</h1>

    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-action="Index">Danh sách Sách</a></li>
        <li class="breadcrumb-item active">Chỉnh sửa</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-edit me-1"></i>
            Cập nhật thông tin: <strong>@Model.nameBook</strong>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-8">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group mb-3">
                            <label asp-for="idBook" class="control-label fw-bold">ID Sách</label>
                            <input asp-for="idBook" class="form-control" readonly style="background-color: #e9ecef;" />
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="nameBook" class="control-label fw-bold">Tên sách</label>
                            <input asp-for="nameBook" class="form-control" />
                            <span asp-validation-for="nameBook" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="descriptionBook" class="control-label fw-bold">Mô tả</label>
                            <textarea asp-for="descriptionBook" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="descriptionBook" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="authorBook" class="control-label fw-bold">Tác giả</label>
                                    <input asp-for="authorBook" class="form-control" />
                                    <span asp-validation-for="authorBook" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="publisherBook" class="control-label fw-bold">Nhà xuất bản</label>
                                    <input asp-for="publisherBook" class="form-control" />
                                    <span asp-validation-for="publisherBook" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="dateBook" class="control-label fw-bold">Ngày xuất bản</label>
                                    <input asp-for="dateBook" class="form-control" type="date" />
                                    <span asp-validation-for="dateBook" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="formatBook" class="control-label fw-bold">Định dạng</label>
                                    <input asp-for="formatBook" class="form-control" />
                                    <span asp-validation-for="formatBook" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="statusBook" class="control-label fw-bold">Trạng thái</label>
                            <select asp-for="statusBook" class="form-select">
                                <option value="Available">Có sẵn</option>
                                <option value="Borrowed">Đang mượn</option>
                                <option value="Lost">Hết / Mất</option>
                            </select>
                            <span asp-validation-for="statusBook" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="noteBook" class="control-label fw-bold">Ghi chú</label>
                            <textarea asp-for="noteBook" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="noteBook" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="imageBook" class="control-label fw-bold">Đường dẫn ảnh (URL)</label>
                            <input asp-for="imageBook" class="form-control" />
                            <span asp-validation-for="imageBook" class="text-danger"></span>
                        </div>

                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-warning">
                                <i class="fa fa-save"></i> Lưu thay đổi
                            </button>
                            <a asp-action="Index" class="btn btn-secondary ms-2">
                                <i class="fa fa-arrow-left"></i> Quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}