@model IEnumerable<Website.Models.Card>

@{
    ViewData["Title"] = "Quản lý Thẻ thư viện";
    Layout = "~/Views/Shared/Master.cshtml";
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/CSS/Admin/Views/Style.css" asp-append-version="true" />
}

<div class="container-fluid">
    <h1 class="mt-4">Danh sách Thẻ thư viện</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row mb-3">
        <div class="col-md-6">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fa fa-plus me-1"></i> Tạo thẻ mới
            </a>
        </div>
        <div class="col-md-6">
            <form asp-action="Index" method="get" class="d-flex justify-content-end">
                <div class="input-group" style="max-width: 400px;">
                    <input type="text" name="search" class="form-control" placeholder="Tìm tên hoặc mã thẻ..." value="@ViewData["CurrentSearch"]" />
                    <button type="submit" class="btn btn-primary">Tìm</button>
                    <a asp-action="Index" class="btn btn-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th style="width: 10%;">Mã thẻ</th>
                <th style="width: 20%;">Tên chủ thẻ</th>
                <th>Email</th>
                <th style="width: 15%;">Điện thoại</th>
                <th style="width: 10%;">Ngày tạo</th>
                <th style="width: 10%;">Trạng thái</th>
                <th style="width: 15%;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.idCard</td>
                        <td class="fw-bold">@item.nameCard</td>
                        <td>@item.emailCard</td>
                        <td>@item.phoneCard</td>
                        <td>@item.dateCard.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (item.statusCard == "Active" || item.statusCard == "Hoat dong")
                            {
                                <span class="badge bg-success">Hoạt động</span>
                            }
                            else if (item.statusCard == "Locked" || item.statusCard == "Khoa")
                            {
                                <span class="badge bg-danger">Đã khóa</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@item.statusCard</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.idCard" class="btn btn-sm btn-warning">
                                <i class="fa fa-edit"></i> Sửa
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.idCard" class="btn btn-sm btn-danger">
                                <i class="fa fa-trash"></i> Xóa
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">
                        Không tìm thấy thẻ thư viện nào.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>