@model Website.Models.Card

@{
    ViewData["Title"] = "Tạo thẻ mới";
    Layout = "~/Views/Shared/Master.cshtml";
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/CSS\Admin\Views\Style.css" asp-append-version="true" />
}

<h2>@ViewData["Title"]</h2>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="idCard" class="control-label">Mã thẻ (Tự động tạo)</label>
                <input asp-for="idCard" class="form-control" readonly />
            </div>
            
            <div class="form-group">
                <label asp-for="nameCard" class="control-label">Tên chủ thẻ</label>
                <input asp-for="nameCard" class="form-control" />
                <span asp-validation-for="nameCard" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="emailCard" class="control-label">Email</label>
                <input asp-for="emailCard" class="form-control" type="email" />
                <span asp-validation-for="emailCard" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="addressCard" class="control-label">Địa chỉ</label>
                <input asp-for="addressCard" class="form-control" />
                <span asp-validation-for="addressCard" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="phoneCard" class="control-label">Điện thoại</label>
                <input asp-for="phoneCard" class="form-control" />
                <span asp-validation-for="phoneCard" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="dateCard" class="control-label">Ngày tạo (Tự động)</label>
                <input asp-for="dateCard" class="form-control" type="date" readonly />
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Tạo mới" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-2">
    <a asp-action="Index" class="btn btn-primary">Quay lại danh sách</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}