@model Website.Models.Card

@{
    ViewData["Title"] = "Xóa thẻ thư viện";
    Layout = "~/Views/Shared/Master.cshtml";
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/CSS/Admin/Views/Style.css" asp-append-version="true" />
}

<div class="container-fluid">
    <h1 class="mt-4 text-danger">Xác nhận xóa</h1>

    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-action="Index">Danh sách Thẻ</a></li>
        <li class="breadcrumb-item active">Xóa</li>
    </ol>

    <div class="alert alert-warning" role="alert">
        <i class="fa fa-exclamation-triangle me-2"></i>
        <strong>Cảnh báo:</strong> Hành động này không thể hoàn tác. Nếu thẻ này đang có sách chưa trả hoặc dữ liệu mượn, việc xóa có thể gây lỗi hệ thống.
    </div>

    <div class="card mb-4 border-danger">
        <div class="card-header bg-danger text-white">
            <i class="fas fa-trash-alt me-1"></i>
            Thông tin thẻ cần xóa
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Mã thẻ:</dt>
                <dd class="col-sm-9 fw-bold">@Model.idCard</dd>

                <dt class="col-sm-3">Tên chủ thẻ:</dt>
                <dd class="col-sm-9">@Model.nameCard</dd>

                <dt class="col-sm-3">Email:</dt>
                <dd class="col-sm-9">@Model.emailCard</dd>

                <dt class="col-sm-3">Điện thoại:</dt>
                <dd class="col-sm-9">@Model.phoneCard</dd>

                <dt class="col-sm-3">Trạng thái:</dt>
                <dd class="col-sm-9">
                    @if (Model.statusCard == "Active" || Model.statusCard == "Hoat dong")
                    {
                        <span class="badge bg-success">Hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Model.statusCard</span>
                    }
                </dd>
            </dl>

            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="idCard" />
                <button type="submit" class="btn btn-danger">
                    <i class="fa fa-trash-alt me-1"></i> Xác nhận xóa vĩnh viễn
                </button>
                <a asp-action="Index" class="btn btn-secondary ms-2">
                    <i class="fa fa-times me-1"></i> Hủy bỏ
                </a>
            </form>
        </div>
    </div>
</div>