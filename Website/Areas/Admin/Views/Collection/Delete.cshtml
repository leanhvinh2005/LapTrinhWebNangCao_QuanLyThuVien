@model Website.Models.Collection

@{
    ViewData["Title"] = "Xác nhận xóa";
    Layout = "~/Views/Shared/Master.cshtml";
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/CSS\Admin\Views\Style.css" asp-append-version="true" />
}

<h2>@ViewData["Title"]</h2>

<h3>Bạn có chắc chắn muốn xóa Bộ sưu tập này không?</h3>
<div>
    <h4>Bộ sưu tập</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.idCollection</dd>

        <dt class="col-sm-2">Tên</dt>
        <dd class="col-sm-10">@Model.nameCollection</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="idCollection" />
        <input type="submit" value="Xóa" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-primary">Hủy</a>
    </form>
</div>