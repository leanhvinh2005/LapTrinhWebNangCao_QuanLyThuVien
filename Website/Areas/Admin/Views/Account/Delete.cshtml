@model Website.Models.User

@{
    ViewData["Title"] = "Xóa tài khoản";
    Layout = "~/Views/Shared/Master.cshtml";
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/CSS/Admin/Views/Style.css" asp-append-version="true" />
}

<div class="container-fluid">
    <h1 class="mt-4 text-danger">Xác nhận xóa</h1>

    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-action="Index">Danh sách Tài khoản</a></li>
        <li class="breadcrumb-item active">Xóa</li>
    </ol>

    <div class="alert alert-warning" role="alert">
        <i class="fa fa-exclamation-triangle me-2"></i>
        <strong>Cảnh báo:</strong> Hành động này không thể hoàn tác. Nếu tài khoản này đang liên kết với Thẻ thư viện hoặc dữ liệu Thủ thư, việc xóa có thể gây lỗi dữ liệu hệ thống.
    </div>

    <div class="card mb-4 border-danger">
        <div class="card-header bg-danger text-white">
            <i class="fas fa-user-times me-1"></i>
            Thông tin tài khoản cần xóa
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">ID Tài khoản:</dt>
                <dd class="col-sm-9 fw-bold">@Model.idUser</dd>

                <dt class="col-sm-3">Tên người dùng:</dt>
                <dd class="col-sm-9">@Model.nameUser</dd>

                <dt class="col-sm-3">Email:</dt>
                <dd class="col-sm-9 text-primary">@Model.emailUser</dd>

            </dl>

            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="idUser" />

                <button type="submit" class="btn btn-danger">
                    <i class="fa fa-trash-alt me-1"></i> Xác nhận xóa vĩnh viễn
                </button>

                <a asp-action="Index" class="btn btn-secondary ms-2">
                    <i class="fa fa-times me-1"></i> Hủy bỏ
                </a>
            </form>
        </div>
    </div>
</div>