@model Website.Models.User
@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/Master.cshtml";
}
<link rel="stylesheet" href="~/CSS/User/Views/Login.css" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/JS/Validation.js"></script>
}

<main class="main_login">
    <div class="logincontainer">
        <p>Đăng nhập</p>
        <form asp-action="Login" method="post" class="loginform">
            <div class="inputfield">
                <label asp-for="emailUser">Email<span style="color: red">*</span></label>
                <span asp-validation-for="emailUser"></span>
                <input asp-for="emailUser" placeholder="Nhập email" />
            </div>
            <div class="inputfield">
                <label asp-for="passwordUser">Mật khẩu<span style="color: red">*</span></label>
                <span asp-validation-for="passwordUser"></span>
                <input asp-for="passwordUser" placeholder="Nhập mật khẩu" />
            </div>
            <div asp-validation-summary="ModelOnly"></div>
            <button type="submit">Đăng nhập</button>
            <div class="extra_login">
                <h1>Quên mật khẩu? <a href="#">Phục hồi</a></h1>
                <h1>Chưa có tài khoản? <a asp-area="User" asp-controller="RegisterAccount" asp-action="RegisterAccount">Đăng ký ngay</a></h1>
            </div>
        </form>
    </div>
</main>

