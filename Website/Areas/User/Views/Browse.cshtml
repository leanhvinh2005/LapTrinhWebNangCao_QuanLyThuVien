@model Website.Models.ViewModels.BookListViewModel
@{
    ViewBag.Title = "Browse";
    Layout = "~/Views/Shared/Master.cshtml";
}
<link rel="stylesheet" href="~/CSS/User/Views/Browse.css" />

<main>
    <div class="uppercontainer">
        <div class="bannercontainer">
            <!--<div class="bannerslide">
            </div>
            
                <div class="bannerslide">
            </div>
            <div class="bannerslide">
            </div>
            -->
        </div>
        <div class="bannerdot">
            <span></span>
            <span></span>
            <span></span>
        </div>
    </div>
    <div class="lowercontainer">
        <div class="title_browse">
            <div>
                <h1>Danh mục sách</h1>
                <h2>Vô số trải nghiệm nằm ngay trong tay</h2>
            </div>
        </div>
        <div class="filtercontainer">
            <div class="leftbuttons">
                @await Component.InvokeAsync("FilterTag")
            </div>
            <div class="rightbuttons">
                <div class="dropdown_right">
                    <button type="button" class="dropmenu_right">View</button>
                    <div class="dropcontent_right">
                        <button asp-area="User" asp-controller="Browse" asp-action="Browse">Đơn giản</button>
                        <button asp-area="User" asp-controller="Browse" asp-action="Browse">Chi tiết</button>
                    </div>
                </div>
                <div class="dropdown_right">
                    <button type="button" class="dropmenu_right">Sort</button>
                    <div class="dropcontent_right">
                        <button asp-area="User" asp-controller="Browse" asp-action="Browse">Top</button>
                        <button asp-area="User" asp-controller="Browse" asp-action="Browse">Hot</button>
                        <button asp-area="User" asp-controller="Browse" asp-action="Browse">Thứ tự chữ cái</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="catalogcontainer">
            @if (Model.Books == null || Model.Books.Count == 0)
            {
                <p>Không kết quả</p>
            }
            else
            {
                @foreach (var item in Model.Books)
                {
                    <div>
                        @await Component.InvokeAsync("BookCard", new { book = item, count = "" })
                    </div>
                }
            }
        </div>
        <div class="pagenavigation">
            <div class="arrowlink">
                <a asp-area="User" asp-controller="Browse" asp-action="Browse" asp-route-currentpage="Model.PagingInfo.CurrentPage - 1"><i class="arrow arrowleft"></i></a>
            </div>
            @for (int i = 1; i <= Model.PagingInfo.TotalPage; i++)
            {
                <div class="pagelink">
                    <a asp-area="User" asp-controller="Browse" asp-action="Browse" asp-route-currentpage="@i">@i</a>
                </div>
            }
            <div class="arrowlink">
                <a asp-area="User" asp-controller="Browse" asp-action="Browse" asp-route-currentpage="Model.PagingInfo.CurrentPage - 1"><i class="arrow arrowright"></i></a>
            </div>
        </div>
    </div>

</main>

