@model Website.Models.ViewModels.CartListViewModel
@{
    ViewBag.Title = "Cart";
    Layout = "~/Views/Shared/Master.cshtml";
}

<main>
    @foreach (var item in Model.Books)
    {
        <div>
            @await Component.InvokeAsync("CartItem", new { book = item })
        </div>
    }
</main>

