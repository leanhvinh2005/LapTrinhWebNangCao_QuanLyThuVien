@model Website.Models.Book
@using System.Security.Claims
<link rel="stylesheet" href="~/CSS/User/Components/BookCard.css" />

<div class="cardcontainer">
    <a asp-area="User" asp-controller="BookDetail" asp-action="BookDetail" asp-route-idbook="@Model.idBook" class="booklink1_bookshelf">
        <img src="@Url.Content(@Model.imageBook)" alt="bookimage" />
    </a>
    <div class="bottomcard">
        <a asp-area="User" asp-controller="BookDetail" asp-action="BookDetail" asp-route-idbook="@Model.idBook" class="booklink2_bookshelf
            <h1>@Model.nameBook</h1>
        </a>
        <a asp-area="User" asp-controller="BookDetail" asp-action="BookDetail" asp-route-idbook="@Model.idBook" class="authorlink_bookshelf">
            <h1>@Model.authorBook</h1>
        </a>
        <form action="/Cart/Add" method="post">
            <input type="hidden" name="idbook" value="@Model.idBook" />
            <button class="addcartbutton">Add to Cart</button>
        </form>
    </div>
</div>

