@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Website.Data
@using Website.Models
@using Website.Services.Other
@inject AuthenticationStateProvider AuthStateProvider
@inject ApplicationDbContext Context

<div class="chaptercontainer">
    <div class="topchapter">
        @if (SelectedChapter != 1)
        {
            <button class="prevbutton">&#10094;</button>
        }
        <select value="@SelectedChapter" @onchange="ChangeChapter">
            @foreach (var item in Chapters)
            {
                <option value="@item.numberChapter">@item.numberChapter</option>
            }
        </select>
        @if (SelectedChapter != MaxChapter)
        {
            <button class="nextbutton">&#10095;</button>
        }
    </div>
    <div class="bottomchapter">
        <h1>@CurrentChapter.titleChapter</h1>
        <div class="contentcontainer">
            <h2>@CurrentChapter.contentChapter</h2>
        </div>
    </div>
</div>


@code {
    [Parameter]
    public List<Chapter> Chapters { get; set; }
    
    private int SelectedChapter = 1;
    private Chapter CurrentChapter => Chapters[SelectedChapter - 1];
    private int MaxChapter => Chapters.Count;

    private void ChangeChapter(ChangeEventArgs e)
    {
        SelectedChapter = int.Parse(e.Value?.ToString() ?? "1");
        InvokeAsync(StateHasChanged);
    }
}
