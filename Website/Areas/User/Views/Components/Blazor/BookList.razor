@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.AspNetCore.WebUtilities
@using Website.Data
@using Website.Models
@using Website.Models.ViewModels
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web;
@using System.Security.Claims
@using Website.Services.Other
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject CartService CartService
@inject SearchService SearchService
@inject ApplicationDbContext Context

@if (CurrentUser?.Identity?.IsAuthenticated == true)
{
    @foreach (var item in FilteredBooks)
    {
        LockedStates.TryGetValue(item.idBook, out var isLocked);
        <div class="cardcontainer">
            <a @onclick="() => NavBookDetail(item.idBook)" class="booklink1">
                <img src="@($"{Nav.BaseUri}{item.imageBook.TrimStart('~', '/')}")" style="@(isLocked ? "opacity: 0.25;" : "opacity: 1;")" alt="bookimage" />
            </a>
            <div class="bottomcard">
                <div>
                    <a @onclick="() => NavBookDetail(item.idBook)" class="booklink2">
                        <h1>@item.nameBook</h1>
                    </a>
                    <a @onclick="() => NavAuthorDetail(item.idBook)" class="authorlink">
                        <h1>@item.authorBook</h1>
                    </a>
                </div>
                @if (isLocked)
                {
                    <button class="disabledcartbutton">Không thêm</button>
                }
                else
                {
                    <button @onclick="() => AddToCart(item.idBook)" class="addcartbutton">Thêm vào giỏ</button>
                }
            </div>
        </div>
    }
}
else
{
    @foreach (var item in Books)
    {
        <div class="cardcontainer">
            <a @onclick="() => NavBookDetail(item.idBook)" class="booklink1">
                <img src="@($"{Nav.BaseUri}{item.imageBook.TrimStart('~', '/')}")" alt="bookimage" />
            </a>
            <div class="bottomcard">
                <a @onclick="() => NavBookDetail(item.idBook)" class="booklink2">
                    <h1>@item.nameBook</h1>
                </a>
                <a @onclick="() => NavAuthorDetail(item.idBook)" class="authorlink">
                    <h1>@item.authorBook</h1>
                </a>
            </div>
        </div>
    }
}


@code {
    [Parameter]
    public List<Book> Books { get; set; } = new();

    private List<Book> FilteredBooks = new();
    private ClaimsPrincipal? CurrentUser;
    private Dictionary<string, bool> LockedStates = new();

    protected override void OnInitialized()
    {
        CartService.OnChange += RecalculateLocksOnCartChange;
        SearchService.OnSearchChanged += UpdateFilter;
        FilteredBooks = Books;
    }

    protected override async Task OnParametersSetAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        CurrentUser = auth.User;

        foreach (var book in Books)
        {
            LockedStates[book.idBook] = false;
        }

        foreach (var book in Books)
        {
            LockedStates[book.idBook] = await Lock(book.idBook);
        }
    }

    private async Task AddToCart(string idbook)
    {
        await CartService.AddToCart(idbook);
    }

    private void NavBookDetail(string idbook)
    {
        var uri = QueryHelpers.AddQueryString("/BookDetail", "idbook", idbook);
        Nav.NavigateTo(uri, forceLoad: true);
    }

    private void NavAuthorDetail(string nameauthor)
    {
        var uri = QueryHelpers.AddQueryString("/BookDetail", "idbook", nameauthor);
        Nav.NavigateTo(uri, forceLoad: true);
    }

    private async Task<bool> Lock(string idbook)
    {
        var available = await Context.SACH
            .Where(b => b.idBook.Substring(0, 2) == idbook.Substring(0, 2))
            .Where(b => b.statusBook == "AVAILABLE")
            .ToListAsync();

        if (available == null || available.Count == 0)
            return true;

        if (CurrentUser.Identity?.IsAuthenticated == true)
        {
            var cardid = CurrentUser.FindFirst("CardId").Value;
            var borrow = await Context.MUONTRA
                .Where(b => b.idCard == cardid)
                .Where(b => b.statusBorrow == "ACTIVE")
                .FirstOrDefaultAsync();

            if (borrow != null)
            {
                var joinborrow = await Context.JOIN_BOOKBORROW
                    .Where(j => j.idBorrow == borrow.idBorrow)
                    .Where(j => j.idBook.Substring(0, 2) == idbook.Substring(0, 2))
                    .Where(j => j.statusBookBorrow == "PENDING")
                    .ToListAsync();

                if (joinborrow == null || joinborrow.Count > 0)
                    return true;
            }

            var cart = CartService.GetCart();

            if (cart.Books.Any(b => b.idBook.Substring(0, 2) == idbook.Substring(0, 2)))
                return true;
        }

        return false;
    }

    private async void RecalculateLocksOnCartChange()
    {
        await RecalculateLocks();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RecalculateLocks()
    {
        LockedStates.Clear();
        foreach (var book in Books)
        {
            LockedStates[book.idBook] = await Lock(book.idBook);
        }
    }

    private void UpdateFilter()
    {
        var q = SearchService.CurrentQuery?.Trim().ToLower() ?? "";

        if (string.IsNullOrWhiteSpace(q))
        {
            FilteredBooks = Books;
        }
        else
        {
            FilteredBooks = Books
            .Where(b =>
            {
                var name = b.nameBook?.ToLower() ?? "";
                return name.StartsWith(q);
            })
            .ToList();
        }

        InvokeAsync(StateHasChanged);
    }
}
