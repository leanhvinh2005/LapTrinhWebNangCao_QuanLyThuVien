@model Website.Models.Book
@using System.Security.Claims
<link rel="stylesheet" href="~/CSS/User/Components/BookCard.css" />

<div class="cardcontainer">
    <a asp-area="User" asp-controller="BookDetail" asp-action="BookDetail" asp-route-id="@Model" class="booklink1">
        <img src="@Url.Content(@Model.imageBook)" alt="bookimage" />
    </a>
    <div class="bottomcard">
        <a asp-area="User" asp-controller="BookDetail" asp-action="BookDetail" asp-route-id="@Model" class="booklink2">
            <h1>@Model.nameBook</h1>
        </a>
        <a asp-area="User" asp-controller="BookDetail" asp-action="BookDetail" asp-route-id="@Model" class="authorlink">
            <h1>@Model.authorBook</h1>
        </a>
        @if (User.IsInRole("User"))
        {
            //<h3>@ViewData["Count"] available</h3>
            <form action="/Cart/Add" method="post">
                <input type="hidden" name="idbook" value="@Model.idBook" />
                <button class="addcartbutton">Add to Cart</button>
            </form>
        }
    </div>
</div>

