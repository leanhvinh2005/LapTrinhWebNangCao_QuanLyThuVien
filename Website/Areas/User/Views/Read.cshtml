@using Website.Areas.User.Views.Components.Blazor
@using Website.Models
@model List<Chapter>
@{
    ViewBag.Title = "Read";
    Layout = "~/Views/Shared/Master.cshtml";
}
<link rel="stylesheet" href="~/CSS/User/Views/Read.css" />

<main class="main_chapter">
    @(await Html.RenderComponentAsync<ReadChapter>(RenderMode.Server, new { Chapters = Model }))
</main>