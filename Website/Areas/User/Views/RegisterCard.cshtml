@model Website.Models.Card
@{
    ViewBag.Title = "RegisterCard";
    Layout = "~/Views/Shared/Master.cshtml";
}
<link rel="stylesheet" href="~/CSS/User/Views/RegisterCard.css" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/JS/Validation.js"></script>
}

<main class="main_registercard">
    <div class="registercardcontainer">
        <p>Đăng ký thẻ thư viện</p>
        <form asp-action="RegisterCard" method="post" class="registercardform">
            <div class="inputfield">
                <label asp-for="nameCard">Họ tên<span style="color: red">*</span></label>
                <span asp-validation-for="nameCard"></span>
                <input asp-for="nameCard" placeholder="Enter full name" />
            </div>
            <div class="inputfield">
                <label asp-for="emailCard">Email<span style="color: red">*</span></label>
                <span asp-validation-for="emailCard"></span>
                <input asp-for="emailCard" placeholder="Enter email" />
            </div>
            <div class="inputfield">
                <label asp-for="addressCard">Địa chỉ<span style="color: red">*</span></label>
                <span asp-validation-for="addressCard"></span>
                <input asp-for="addressCard" placeholder="Enter address" />
            </div>
            <div class="inputfield">
                <label asp-for="phoneCard">Số điện thoại<span style="color: red">*</span></label>
                <span asp-validation-for="phoneCard"></span>
                <input asp-for="phoneCard" placeholder="Enter phone number" />
            </div>
            <div class="inputfield">
                <label asp-for="dateCard">Ngày sinh<span style="color: red">*</span></label>
                <span asp-validation-for="dateCard"></span>
                <input asp-for="dateCard" />
            </div>
            <div asp-validation-summary="ModelOnly"></div>
            <button type="submit">Đăng ký</button>
            <div class="extra_registercard">
                <h1>Có thẻ? <a asp-area="User" asp-controller="RegisterAccount" asp-action="RegisterAccount">Đăng ký tài khoản</a></h1>
            </div>
        </form>
    </div>
</main>

