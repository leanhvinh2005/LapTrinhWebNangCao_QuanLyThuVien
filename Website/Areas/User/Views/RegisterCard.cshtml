@model Website.Models.Card
@{
    ViewBag.Title = "RegisterCard";
    Layout = "~/Views/Shared/Master.cshtml";
}
<link rel="stylesheet" href="~/CSS/User/Views/RegisterCard.css" />

<main>
    <p>Register library card</p>
    <form asp-action="RegisterCard" method="post">
        <div class="inputfield">
            <label asp-for="nameCard">Full name</label>
            <span asp-validation-for="nameCard"></span>
            <input asp-for="nameCard" placeholder="Enter full name" />
        </div>
        <div class="inputfield">
            <label asp-for="emailCard">Email</label>
            <span asp-validation-for="emailCard"></span>
            <input asp-for="emailCard" placeholder="Enter email" />
        </div>
        <div class="inputfield">
            <label asp-for="addressCard">Address</label>
            <span asp-validation-for="addressCard"></span>
            <input asp-for="addressCard" placeholder="Enter address" />
        </div>
        <div class="inputfield">
            <label asp-for="phoneCard">Phone number</label>
            <span asp-validation-for="phoneCard"></span>
            <input asp-for="phoneCard" placeholder="Enter phone number" />
        </div>
        <div class="inputfield">
            <label asp-for="dateCard">Date of birth</label>
            <span asp-validation-for="dateCard"></span>
            <input asp-for="dateCard" />
        </div>
        <div asp-validation-summary="ModelOnly"></div>
        <button type="submit">Register</button>
    </form>
</main>

