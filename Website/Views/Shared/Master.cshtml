<!DOCTYPE html>

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewData["Title"] - Website</title>
        <link rel="stylesheet" href="~/CSS/Shared/Master.css" asp-append-version="true" />
    </head>
    <body>
        <header>
            @await Component.InvokeAsync("Navbar")
        </header>

        <main role="main">
            @RenderBody()
        </main>

        <footer>
            @await Component.InvokeAsync("Footer")
        </footer>
    </body>
</html>
