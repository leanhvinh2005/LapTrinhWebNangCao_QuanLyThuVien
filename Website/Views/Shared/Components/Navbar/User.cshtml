@using Website.Views.Shared.Components.Blazor
@using System.Security.Claims

<link rel="stylesheet" href="~/CSS/Shared/Navbar/User.css" />
<link rel="stylesheet" href="~/CSS/Shared/DisplayNumber.css" />

<nav class="navbar">
    <div class="left_navbar">
        <img src="~/Images/Logos/ArcadiaLogoSmall.png" alt="ArcadiaLogo" class="arcadialogo_navbar" />
        <form action="/Browse/Search" method="post">
            <input type="text" name="search" placeholder="Search..." />
            <button type="submit">
                <img src="~/Images/Navbar/Search.png" alt="Search" class="search_navbar" />
            </button>
        </form>
        <form asp-action="Logout" asp-controller="Login" method="post">
            @Html.AntiForgeryToken()
            <button type="submit">Logout</button>
        </form>
    </div>
    <div class="right_navbar">
        <div class="navlink">
            <a asp-area="User" asp-controller="Home" asp-action="Home">Trang chủ</a>
        </div>
        <div class="navlink">
            <a asp-area="User" asp-controller="Browse" asp-action="Browse">Khám phá</a>
        </div>
        <div class="navlink">
            <a asp-area="User" asp-controller="Contact" asp-action="Contact">Liên hệ</a>
        </div>
        <div class="buttonlink">
            <a asp-area="User" asp-controller="Bookshelf" asp-action="Bookshelf" class="buttonlink_link1">
                <img src="~/Images/Navbar/BookStack.png" alt="BookStack" />
            </a>
        </div>
        <div class="buttonlink">
            @(await Html.RenderComponentAsync<DisplayNumber>(RenderMode.Server))
            <a asp-area="User" asp-controller="Cart" asp-action="Cart" class="buttonlink_link2">
                <img src="~/Images/Navbar/Cart.png" alt="Cart" />
            </a>
        </div>
        <div class="buttonlink buttonprofile">
            <a asp-area="User" asp-controller="Profile" asp-action="Profile" class="buttonlink_link3">
                <img src="~/Images/Navbar/User.png" alt="User" class="buttonlink_image3" />
            </a>
            <p>@User.FindFirstValue(ClaimTypes.Name)</p>
        </div>
    </div>
</nav>